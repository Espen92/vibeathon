    <string name="action_grant">Grant</string>
    <string name="action_install">Install</string>
    <string name="action_app_info">App info</string>
    <string name="restricted_settings_hint">Android 13+: if the accessibility toggle is greyed out (\"Restricted setting\"), open App info → ⋮ → Allow restricted settings, then try again.</string>
    <string name="start_overlay">Start overlay</string>
    <string name="stop_overlay">Stop overlay</string>
    <string name="overlay_needs_permissions">Grant \"Display over other apps\" and microphone permission first.</string>

    <string name="section_settings">Settings</string>
    <string name="setting_strategy">Delivery strategy</string>
    <string name="strategy_share">Share intent (default) – share the audio file to ChatGPT and press Send</string>
    <string name="strategy_accessibility">Accessibility – attach the file through ChatGPT\'s attachment menu (Android 10+)</string>
    <string name="strategy_transcribe">Transcribe fallback – on-device speech-to-text, send the transcript as text</string>
    <string name="strategy_transcribe_note">Use the transcribe fallback if ChatGPT rejects or ignores audio attachments for your model or account. It uses Android\'s SpeechRecognizer (on-device when available) instead of recording a file.</string>
    <string name="transcribe_unavailable">Speech recognition is not available on this device.</string>
    <string name="setting_prompt">Prompt sent with the voice file</string>
    <string name="setting_auto_read">Automatically tap \"Read aloud\" when the reply finishes</string>
    <string name="setting_reply_timeout">Reply timeout (seconds)</string>
    <string name="setting_max_recording">Max recording length (seconds)</string>

    <string name="section_debug">Debug log</string>
    <string name="debug_hint">Every automation step is logged here. When a step times out, the visible button labels are listed – add them to Selectors.java if ChatGPT renamed a button.</string>
