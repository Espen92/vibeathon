    <string name="default_prompt">respond to the prompt in the voice file</string>

    <!-- Setup screen -->
    <string name="setup_title">Hands-free ChatGPT voice</string>
    <string name="setup_intro">Tap the floating bubble once to start a voice memo and again to stop. The memo is sent to your current ChatGPT chat and the reply is read aloud automatically.</string>
    <string name="section_setup">Setup checklist</string>
    <string name="check_overlay">Display over other apps</string>
    <string name="check_accessibility">Accessibility service enabled</string>
    <string name="check_microphone">Microphone permission</string>
    <string name="check_notifications">Notification permission</string>
    <string name="check_chatgpt">ChatGPT installed</string>
